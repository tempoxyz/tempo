#!/usr/bin/env bash
# Prepares an Amp orb for building and testing Tempo and Zones, including the local zone services
# in .amp/services.yaml. Idempotent; safe to rerun on a warm snapshot.
#
# Also prepares a Pyramid Hand, and a Pyramid golden-disk warmer, which runs this and then
# .agents/warm on reviewed main so new Hands start from a built target/. There every build stays
# on the Hand's own disk: no shared Archil cache, no fail-closed target and no zone services.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

NEXTEST_VERSION="0.9.127" # matches .github/workflows/test.yml
SCCACHE_VERSION="0.14.0"  # matches Dockerfile.chef
ARCHIL_MOUNT="$HOME/archil" # mounted by .agents/resume

# Pyramid's Hand image, which its warmers share, ships this directory.
pyramid_hand() { [[ -d /usr/local/lib/pyramid-hand ]]; }

step() {
  local name="$1"
  shift
  local start=$SECONDS
  echo "==> $name"
  "$@"
  echo "<== $name ($((SECONDS - start))s)"
}

install_apt_packages() {
  # Build deps from Dockerfile.chef, plus shellcheck for tempoup tests and jq for .amp services.
  local packages=(build-essential ca-certificates curl git jq pkg-config libssl-dev clang libclang-dev mold shellcheck)
  local missing=()
  for pkg in "${packages[@]}"; do
    dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q "install ok installed" || missing+=("$pkg")
  done
  if ((${#missing[@]})); then
    sudo apt-get update -qq
    sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends "${missing[@]}"
  else
    echo "all apt packages present"
  fi
}

install_rust() {
  if pyramid_hand && command -v rustup >/dev/null; then
    # The Hand image's own toolchains, which warmers and Hands share: a warm build's fingerprints
    # name the rustc that made them, so a toolchain of our own would rebuild everything on a Hand.
    # Tools below (nextest, just) still go to ~/.cargo/bin, after the image's cargo on PATH.
    mkdir -p "$HOME/.cargo/bin"
    export PATH="$PATH:$HOME/.cargo/bin"
    rustup component add --toolchain stable rustfmt clippy
    rustup toolchain list | grep -q '^nightly' ||
      rustup toolchain install nightly --profile minimal -c rustfmt,clippy --allow-downgrade
    return
  fi
  if [[ ! -x "$HOME/.cargo/bin/rustup" ]]; then
    # Rustup adds `. "$HOME/.cargo/env"` to ~/.profile, ~/.bash_profile, and ~/.bashrc.
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs |
      sh -s -- -y --profile minimal --default-toolchain none
  fi
  # shellcheck disable=SC1091
  source "$HOME/.cargo/env"
  local installed
  installed="$(rustup toolchain list)"
  grep -q '^stable' <<<"$installed" ||
    rustup toolchain install stable --profile minimal -c rustfmt,clippy
  # Nightly is used for `cargo +nightly fmt` (see AGENTS.md) and clippy in CI.
  grep -q '^nightly' <<<"$installed" ||
    rustup toolchain install nightly --profile minimal -c rustfmt,clippy --allow-downgrade
  rustup default stable >/dev/null
}

install_nextest() {
  if [[ "$(cargo nextest --version 2>/dev/null | head -1)" != "cargo-nextest $NEXTEST_VERSION"* ]]; then
    curl -LsSf "https://get.nexte.st/$NEXTEST_VERSION/linux" | tar zxf - -C "$HOME/.cargo/bin"
  fi
  cargo nextest --version | head -1
}

install_just() {
  if ! command -v just >/dev/null; then
    curl --proto '=https' --tlsv1.2 -sSf https://just.systems/install.sh | bash -s -- --to "$HOME/.cargo/bin"
  fi
  just --version
}

install_sccache() {
  if [[ "$(sccache --version 2>/dev/null)" != "sccache $SCCACHE_VERSION" ]]; then
    local name="sccache-v$SCCACHE_VERSION-x86_64-unknown-linux-musl"
    curl -fsSL "https://github.com/mozilla/sccache/releases/download/v$SCCACHE_VERSION/$name.tar.gz" |
      tar xzf - -C "$HOME/.cargo/bin" --strip-components=1 "$name/sccache"
  fi
  sccache --version
}

configure_build_cache() {
  # Every orb shares one sccache directory on the Archil disk that .agents/resume mounts. The
  # wrapper refuses to compile without that mount. It is named `sccache` so the cc crate also
  # routes C/C++ builds (rocksdb, jemalloc) through it.
  # Any orb can write cache entries that every other orb links, so all orbs of this project are
  # one trust domain: do not build untrusted code (e.g. external PRs) in them.
  local wrapper_dir="$HOME/.cargo/archil-sccache"
  mkdir -p "$wrapper_dir"
  cat >"$wrapper_dir/sccache" <<EOF
#!/bin/sh
if ! mountpoint -q "$ARCHIL_MOUNT"; then
  echo "Archil is not mounted; run .agents/resume before building" >&2
  exit 1
fi
exec "$HOME/.cargo/bin/sccache" "\$@"
EOF
  chmod +x "$wrapper_dir/sccache"
  mkdir -p "$HOME/.config/sccache"
  cat >"$HOME/.config/sccache/config" <<EOF
[cache.disk]
dir = "$ARCHIL_MOUNT/sccache"
size = $((20 * 1024 * 1024 * 1024))
EOF
  # Pin vergen's build timestamp like CI does, so reth-node-core and its dependents hit the cache.
  cat >"$HOME/.cargo/config.toml" <<EOF
[build]
rustc-wrapper = "$wrapper_dir/sccache"

[env]
SOURCE_DATE_EPOCH = "1700000000"
EOF
}

install_foundry() {
  # Anvil runs the local Tempo L1; forge builds the zone contracts.
  if [[ ! -x "$HOME/.foundry/bin/foundryup" ]]; then
    curl --proto '=https' --tlsv1.2 -sSfL https://foundry.paradigm.xyz | bash
  fi
  export PATH="$HOME/.foundry/bin:$PATH"
  # shellcheck disable=SC1091
  source .amp/versions.env
  if ! anvil --version 2>/dev/null | grep -q "${FOUNDRY_VERSION#v}"; then
    foundryup --install "$FOUNDRY_VERSION"
  fi
  local marker="# tempo foundry"
  if ! grep -Fqx "$marker" "$HOME/.bash_profile" 2>/dev/null; then
    # shellcheck disable=SC2016
    printf '\n%s\nexport PATH="$HOME/.foundry/bin:$PATH"\n' "$marker" >>"$HOME/.bash_profile"
  fi
}

install_archil() {
  # FUSE client for the shared Archil disk that .agents/resume mounts.
  if ! command -v archil >/dev/null; then
    curl -fsSL https://archil.com/install | ARCHIL_SKIP_IAM_CHECK=1 sh
  fi
  archil --version
}

configure_pyramid_hand() {
  # On a golden disk the repository root is a volume of its own, which the warmer fills and new
  # Hands clone copy-on-write. Keep cargo's downloaded crates and git checkouts there too, so a Hand
  # reuses the warmer's at the same ~/.cargo paths the warm build's fingerprints name.
  if mountpoint -q "$PWD"; then
    local dir
    for dir in registry git; do
      local home_dir="$HOME/.cargo/$dir" shared=".git/pyramid-cargo-$dir"
      [[ -L "$home_dir" ]] && continue
      mkdir -p "$shared" "$HOME/.cargo"
      if [[ -d "$home_dir" ]]; then
        cp -a --no-clobber "$home_dir/." "$shared/" 2>/dev/null || true
        rm -rf "$home_dir"
      fi
      ln -s "$PWD/$shared" "$home_dir"
    done
  fi
  # Pin vergen's build timestamp like CI and orbs do, so reth-node-core and its dependents keep the
  # warm build's fingerprints. orb.toml is ignored, so it stays on the volume for every clone.
  printf '[env]
SOURCE_DATE_EPOCH = "1700000000"
' > .cargo/orb.toml.tmp
  mv .cargo/orb.toml.tmp .cargo/orb.toml
}

step "apt packages" install_apt_packages
pyramid_hand || step "archil" install_archil
step "rust toolchains" install_rust
if pyramid_hand; then
  step "pyramid hand" configure_pyramid_hand
else
  step "sccache" install_sccache
  step "build cache" configure_build_cache
fi
step "cargo-nextest" install_nextest
step "just" install_just
step "foundry" install_foundry
step "submodules" git submodule update --init --recursive --depth 1
# Pulls service images and the pinned explorer checkout; Amp starts the services.
pyramid_hand || step "zone services" bash .amp/setup
step "zone contracts" forge build --root crates/zones/contracts --skip test --no-lint
# Fetch only queries rustc; it must work before Archil is mounted, without starting sccache.
step "cargo fetch" env RUSTC_WRAPPER= cargo fetch --locked
# A Pyramid Hand keeps its target/, which a golden disk brings already built.
pyramid_hand && exit 0
# Drop disposable outputs from old snapshots, without following an existing remote target link.
rm -rf target
mkdir -p .amp
rm -f .amp/archil-output-id
# A reusable snapshot must contain neither an orb identity nor local build outputs. Resume
# enables output only after mounting Archil and choosing a private directory.
printf '[build]\ntarget-dir = "/dev/null/tempo-target"\nbuild-dir = "/dev/null/tempo-target"\n' > .cargo/orb.toml.tmp
mv .cargo/orb.toml.tmp .cargo/orb.toml
