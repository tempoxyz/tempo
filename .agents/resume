#!/usr/bin/env bash
# Runs on every orb wake. Keep fast: only checks that the toolchain from .agents/setup is present
# and mounts the shared Archil disk.
set -euo pipefail

# shellcheck disable=SC1091
source "$HOME/.cargo/env"
cargo --version
cargo nextest --version | head -1

# ARCHIL_MOUNT_TOKEN (secret), ARCHIL_DISK_ID, and ARCHIL_REGION come from Amp workspace settings.
# Conditional mode lets every orb read and write the disk at once without `archil checkout`.
archil_mount="$HOME/archil"
if [[ -z "${ARCHIL_MOUNT_TOKEN:-}" || -z "${ARCHIL_DISK_ID:-}" ]]; then
  echo "Archil not configured; skipping mount"
elif findmnt -n "$archil_mount" >/dev/null; then
  echo "Archil already mounted at $archil_mount"
else
  mkdir -p "$archil_mount"
  sudo --preserve-env=ARCHIL_MOUNT_TOKEN \
    archil mount "$ARCHIL_DISK_ID" "$archil_mount" --region "${ARCHIL_REGION:-aws-us-west-2}" --conditional
  # New disks are owned by root; the ownership change persists on the disk.
  [[ -O "$archil_mount" ]] || sudo chown "$(id -u):$(id -g)" "$archil_mount"
  echo "Archil mounted at $archil_mount"
fi
