#!/usr/bin/env bash
# Runs on every orb wake. Keep fast: only checks that the toolchain from .agents/setup is present.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

# Orbs set up when Cargo built on the shared Archil disk route rustc through a wrapper that refuses
# to run without the mount, and point target/ at that disk. Remove both so Cargo builds in
# ./target on the orb's own disk.
rm -rf "$HOME/.cargo/archil-sccache" "$HOME/.config/sccache" .amp/archil-output-id
if grep -qs archil-sccache "$HOME/.cargo/config.toml"; then sed -i /archil-sccache/d "$HOME/.cargo/config.toml"; fi
if grep -qs target-dir .cargo/orb.toml; then rm -f .cargo/orb.toml; fi

# shellcheck disable=SC1091
source "$HOME/.cargo/env"
cargo --version
cargo nextest --version | head -1
