+
+async fn acquire_payload_permit<T>(
+    guard: &PayloadTaskGuard,
+    result: &mut oneshot::Sender<T>,
+) -> Option<tokio::sync::OwnedSemaphorePermit> {
+    tokio::select! {
+        biased;
+        () = result.closed() => None,
+        permit = guard.acquire_owned() => Some(permit),
+    }
+}
+
+#[cfg(test)]
+mod cancellation_tests {
+    use super::*;
+
+    #[test]
+    fn live_consumer_gets_permit() {
+        tokio::runtime::Builder::new_current_thread().build().unwrap().block_on(async {
+            let guard = PayloadTaskGuard::new(1);
+            let (mut tx, _rx) = oneshot::channel::<()>();
+            let permit = acquire_payload_permit(&guard, &mut tx).await.unwrap();
+            assert_eq!(guard.available_permits(), 0);
+            drop(permit);
+            assert_eq!(guard.available_permits(), 1);
+        });
+    }
+
+    #[test]
+    fn abandoned_consumer_does_not_take_permit() {
+        tokio::runtime::Builder::new_current_thread().build().unwrap().block_on(async {
+            let guard = PayloadTaskGuard::new(1);
+            let (mut tx, rx) = oneshot::channel::<()>();
+            drop(rx);
+            assert!(acquire_payload_permit(&guard, &mut tx).await.is_none());
+            assert_eq!(guard.available_permits(), 1);
+        });
+    }
+
+    #[test]
+    fn queued_consumer_cancellation_releases_resources() {
+        tokio::runtime::Builder::new_current_thread().enable_time().build().unwrap().block_on(
+            async {
+                let guard = PayloadTaskGuard::new(1);
+                let _occupied = guard.acquire_owned().await;
+                let (mut result_tx, result_rx) = oneshot::channel::<()>();
+                let resource = Arc::new(());
+                let queued_resource = resource.clone();
+                let task = tokio::spawn(async move {
+                    let _resource = queued_resource;
+                    assert!(acquire_payload_permit(&guard, &mut result_tx).await.is_none());
+                });
+                tokio::task::yield_now().await;
+                drop(result_rx);
+                tokio::time::timeout(Duration::from_secs(1), task).await.unwrap().unwrap();
+                assert_eq!(Arc::strong_count(&resource), 1);
+            },
+        );
+    }
+}
