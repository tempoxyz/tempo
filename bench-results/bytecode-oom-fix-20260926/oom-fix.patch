+        assert_eq!(executor.db.bundle_state.size_hint(), 0);
+        assert_eq!(executor.cached_bytecode_size(), expected);
+
+        // Repeated reads share the same cached allocation.
+        executor.db.code_by_hash(hash).unwrap();
+        assert_eq!(executor.cached_bytecode_size(), expected);
+        executor.db.cache.contracts.clear();
+        assert_eq!(executor.cached_bytecode_size(), 0);
+    }
