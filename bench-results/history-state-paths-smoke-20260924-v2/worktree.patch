@@ -39,6 +39,7 @@ const PAYMENTS_BLOAT_WORST_CASE = {
 const GENERAL_STATE_ACCESS_WORST_CASE = {
     dependent_preset: "state_access_dependent"
     predictable_preset: "state_access_predictable"
+    resident_preset: "state_access_resident"
