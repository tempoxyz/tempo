+        for datadir in [$ctx.a.datadir $ctx.b.datadir] {
+            let result = (run-external $checkpoint_tool ($datadir | path join "db") | complete)
+            if $result.exit_code != 0 {
+                print $"Cannot verify restored checkpoint: ($result.stderr)"
+                exit 1
+            }
