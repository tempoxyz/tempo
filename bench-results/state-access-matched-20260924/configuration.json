    },
    {
      "id": "bytecode",
      "scenario": "history_code",
      "description": "128 history-selected EXTCODECOPY accesses to unique 24 KiB contracts",
      "operations_per_transaction": 128
    },
    {
      "id": "writes",
      "scenario": "history_write",
      "description": "1024 cold reads and nonzero-to-nonzero writes in a history-selected populated logical page",
      "operations_per_transaction": 1024
    }
  ],
  "dry_run": false
}
