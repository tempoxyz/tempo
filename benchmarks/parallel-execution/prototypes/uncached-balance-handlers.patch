@@ -66,6 +66,22 @@ impl<K, V: StorableType> Mapping<K, V> {
         self.base_slot
     }
 
+    /// Computes an owned handler without adding it to this mapping's cache.
+    ///
+    /// Useful for short-lived leaf accesses that do not need a stable reference:
+    /// no box or cache entry is allocated. Repeated accesses can use [`Self::at`].
+    #[inline]
+    pub fn at_uncached(&self, key: &K) -> V::Handler
+    where
+        K: StorageKey,
+    {
+        V::handle(
+            key.mapping_slot(self.base_slot),
+            LayoutCtx::FULL,
+            self.address,
+        )
+    }
+
     /// Returns a `Handler` for the given key.
     ///
     /// This enables the composable pattern: `mapping.at(&key).read()`
