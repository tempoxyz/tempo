+//! Copy only state consumed by the background trie, without changing the EVM journal.
+
+use reth_engine_tree::tree::payload_processor::multiproof::{
+    StateHookSender, StateRootHandle, StateRootMessage,
+};
+use reth_evm::block::{OnStateHook, StateChangeSource};
+use reth_revm::state::EvmState;
+
+pub(crate) fn trie_state_hook(handle: &StateRootHandle) -> impl OnStateHook + use<> {
+    let sender = StateHookSender::new(handle.updates_tx().clone());
+    move |source: StateChangeSource, state: &EvmState| {
+        let _ = sender.send(StateRootMessage::StateUpdate(
+            source.into(),
+            copy_touched_state(state),
+        ));
+    }
+}
+
+/// Reth's `evm_state_to_hashed_post_state` ignores untouched accounts. Avoid
+/// copying their read caches onto the trie worker's queue. Keep bulk cloning
+/// within each touched account: rebuilding storage maps entry by entry is more
+/// expensive for writes than leaving slot filtering to the hashing worker.
+fn copy_touched_state(state: &EvmState) -> EvmState {
+    let touched = state
+        .values()
+        .filter(|account| account.is_touched())
+        .count();
+    if touched == state.len() {
+        return state.clone();
+    }
+    let mut changes = EvmState::with_capacity_and_hasher(touched, Default::default());
+    for (address, account) in state {
+        if account.is_touched() {
+            changes.insert(*address, account.clone());
+        }
+    }
+    changes
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use alloy_primitives::{Address, B256, U256};
+    use reth_engine_tree::tree::payload_processor::multiproof::evm_state_to_hashed_post_state;
+    use reth_evm::block::{StateChangePostBlockSource, StateChangePreBlockSource};
+    use reth_revm::state::{Account, AccountInfo, AccountStatus, EvmStorageSlot};
+    use std::{hint::black_box, time::Instant};
+
+    #[test]
+    fn trie_projection_matches_full_journal() {
+        // Exercise every status combination, including creation, destruction,
+        // empty/nonexistent accounts, cold reads, and reverted writes. The
+        // independent reference is the pinned Reth conversion used by the trie.
+        for bits in 0..=u8::MAX {
+            for balance in [U256::ZERO, U256::from(7), U256::MAX] {
+                let mut account = Account::from(AccountInfo {
+                    balance,
+                    nonce: if balance.is_zero() { 0 } else { 13 },
+                    ..Default::default()
+                });
+                account.status = AccountStatus::from_bits_retain(bits);
+                account.storage = [
+                    (U256::ZERO, EvmStorageSlot::new(U256::ZERO, 1)),
+                    (U256::from(1), EvmStorageSlot::new(U256::from(7), 1)),
+                    (
+                        U256::from(2),
+                        EvmStorageSlot::new_changed(U256::ZERO, U256::MAX, 1),
+                    ),
+                    (
+                        U256::from(3),
+                        EvmStorageSlot::new_changed(U256::from(7), U256::ZERO, 1),
+                    ),
+                    (
+                        U256::from(4),
+                        EvmStorageSlot::new_changed(U256::from(7), U256::from(7), 1),
+                    ),
+                ]
+                .into_iter()
+                .collect();
+                let state = [(Address::ZERO, account)].into_iter().collect();
+                assert_eq!(
+                    evm_state_to_hashed_post_state(copy_touched_state(&state)),
+                    evm_state_to_hashed_post_state(state),
+                    "status {bits}, balance {balance}",
+                );
+            }
+        }
+    }
+
+    fn fixture(accounts: usize, slots: usize, touched: usize, written: usize) -> EvmState {
+        (0..accounts)
+            .map(|index| {
+                let mut account = Account::default();
+                if index < touched {
+                    account.mark_touch();
+                }
+                account.storage = (0..slots)
+                    .map(|slot| {
+                        (
+                            U256::from(slot),
+                            EvmStorageSlot::new_changed(
+                                U256::from(slot),
+                                U256::from(slot + usize::from(slot < written)),
+                                0,
+                            ),
+                        )
+                    })
+                    .collect();
+                (Address::from_word(B256::from(U256::from(index))), account)
+            })
+            .collect()
+    }
+
+    #[test]
+    fn hook_preserves_update_and_completion_order() {
+        let (tx, rx) = crossbeam_channel::unbounded();
+        let (_, root_rx) = std::sync::mpsc::channel();
+        let handle = StateRootHandle::new(B256::ZERO, tx, root_rx);
+        let mut hook = trie_state_hook(&handle);
+        let state = fixture(16, 32, 3, 4);
+        let original = state.clone();
+        let sources = [
+            StateChangeSource::PreBlock(StateChangePreBlockSource::BlockHashesContract),
+            StateChangeSource::Transaction(0),
+            StateChangeSource::PostBlock(StateChangePostBlockSource::WithdrawalRequestsContract),
+        ];
+        for source in sources {
+            hook.on_state(source, &state);
+        }
+        // Empty updates and the final completion marker retain their position.
+        hook.on_state(StateChangeSource::Transaction(1), &EvmState::default());
+        drop(hook);
+        assert_eq!(state, original);
+        for source in sources {
+            let StateRootMessage::StateUpdate(actual_source, changes) = rx.try_recv().unwrap()
+            else {
+                panic!("state update must precede completion");
+            };
+            assert_eq!(format!("{actual_source:?}"), format!("{source:?}"));
+            assert_eq!(changes.len(), 3);
+            assert_eq!(changes.values().map(|a| a.storage.len()).sum::<usize>(), 96);
+            assert_eq!(
+                evm_state_to_hashed_post_state(changes),
+                evm_state_to_hashed_post_state(state.clone()),
+            );
+        }
+        assert!(
+            matches!(rx.try_recv().unwrap(), StateRootMessage::StateUpdate(_, state) if state.is_empty())
+        );
+        assert!(matches!(
+            rx.try_recv().unwrap(),
+            StateRootMessage::FinishedStateUpdates
+        ));
+        assert!(rx.try_recv().is_err());
+    }
+
+    #[test]
+    #[ignore = "microbenchmark; run in release with --nocapture"]
+    fn trie_journal_copy_throughput() {
+        for (name, state) in [
+            ("read_heavy", fixture(16, 32, 3, 4)),
+            ("all_writes", fixture(8, 32, 8, 32)),
+            ("account_only", fixture(8, 0, 3, 0)),
+        ] {
+            assert_eq!(
+                evm_state_to_hashed_post_state(copy_touched_state(&state)),
+                evm_state_to_hashed_post_state(state.clone()),
+            );
+            for sample in 0..7 {
+                for compact in if sample % 2 == 0 {
+                    [false, true]
+                } else {
+                    [true, false]
+                } {
+                    let start = Instant::now();
+                    for _ in 0..50_000 {
+                        black_box(if compact {
+                            copy_touched_state(black_box(&state))
+                        } else {
+                            black_box(&state).clone()
+                        });
+                    }
+                    println!(
+                        "{name}\t{sample}\t{compact}\t{}",
+                        start.elapsed().as_secs_f64()
+                    );
+                }
+            }
+        }
+    }
+}
