FROM nitro-bootstrap AS nitro-bootstrap

FROM public.ecr.aws/amazonlinux/amazonlinux:2023@sha256:6d8e068b91f351df5bf6acd4bd261316e42747ad4bae76689ff6f4939e2180a2

ARG NITRO_CLI_VERSION=1.4.5-0.amzn2023

RUN dnf install -y \
        file \
        "aws-nitro-enclaves-cli-${NITRO_CLI_VERSION}" \
        "aws-nitro-enclaves-cli-devel-${NITRO_CLI_VERSION}" \
    && dnf clean all \
    && rm -rf /var/cache/dnf

# Replace Nitro CLI's precompiled bootstrap blobs with one matched set from the pinned AWS
# bootstrap build: hardened Linux 6.6.79, its config and command line, the matching NSM driver
# and init, and AWS's patched linuxkit. Preserve the trusted-entropy policy for TLS keys below.
COPY --from=nitro-bootstrap /blobs/x86_64/ /usr/share/nitro_enclaves/blobs/
RUN cp /usr/share/nitro_enclaves/blobs/cmdline /tmp/aws-nitro-cmdline

RUN file /usr/share/nitro_enclaves/blobs/bzImage | grep -Fq 'version 6.6.79' \
    && grep -aFq 'vermagic=6.6.79' /usr/share/nitro_enclaves/blobs/nsm.ko \
    && sed -e 's/random\.trust_cpu=on/random.trust_cpu=off/g' \
        -e '$s/$/ random.trust_bootloader=off/' \
        /tmp/aws-nitro-cmdline > /usr/share/nitro_enclaves/blobs/cmdline \
    && grep -Fqw 'random.trust_cpu=off' /usr/share/nitro_enclaves/blobs/cmdline \
    && grep -Fqw 'random.trust_bootloader=off' /usr/share/nitro_enclaves/blobs/cmdline \
    && ! grep -Fqw 'random.trust_cpu=on' /usr/share/nitro_enclaves/blobs/cmdline \
    && rm /tmp/aws-nitro-cmdline \
    && cd /usr/share/nitro_enclaves/blobs \
    && sha384sum bzImage bzImage.config cmdline nsm.ko init linuxkit \
        > /usr/share/nitro_enclaves/components.sha384

ENTRYPOINT ["nitro-cli"]
