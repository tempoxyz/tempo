FROM rust:1.96-alpine@sha256:a41f7740f8b45d45795624eec13a8b42263cc700f19f7e4e86e04d3dda08a479 AS proxy-chef
RUN cargo install cargo-chef@0.1.77 --locked
WORKDIR /build

FROM proxy-chef AS proxy-planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json \
    && find . -name Cargo.toml -exec sh -c 'for manifest do \
         mkdir -p "/manifests/$(dirname "$manifest")"; \
         cp "$manifest" "/manifests/$manifest"; \
       done' sh {} + \
    && cp Cargo.lock /manifests/Cargo.lock

FROM proxy-chef AS proxy-builder
COPY --from=proxy-planner /build/recipe.json recipe.json
RUN cargo chef cook --locked --release --package tempo-vsock-proxy --recipe-path recipe.json
# Restore real workspace versions and inherited lints after chef's dummy recipe.
COPY --from=proxy-planner /manifests/ .
# Other workspace source changes no longer invalidate proxy compilation.
COPY bin/prover/vsock-proxy bin/prover/vsock-proxy
RUN cargo build --locked --release --package tempo-vsock-proxy

FROM public.ecr.aws/amazonlinux/amazonlinux:2023@sha256:6d8e068b91f351df5bf6acd4bd261316e42747ad4bae76689ff6f4939e2180a2

# Keep these IDs in sync with the Pod security context and the Talos udev rule.
ARG PROVER_UID=10001
ARG PROVER_GID=10001
# Create the fixed runtime identity
RUN dnf install -y shadow-utils
RUN groupadd --gid "${PROVER_GID}" ne
RUN useradd --uid "${PROVER_UID}" --gid "${PROVER_GID}" --no-create-home tempo-zone-prover

# Install the Nitro CLI package.
ARG NITRO_CLI_VERSION=1.4.5-0.amzn2023
RUN dnf install -y "aws-nitro-enclaves-cli-${NITRO_CLI_VERSION}" jq
RUN dnf clean all
RUN rm -rf /var/cache/dnf

# Grant the prover group access to Nitro Enclaves runtime state and logs.
RUN install -d -m 0775 -o root -g "${PROVER_GID}" /run/nitro_enclaves /var/log/nitro_enclaves
RUN install -m 0664 -o root -g "${PROVER_GID}" /dev/null /var/log/nitro_enclaves/nitro_enclaves.log

ARG NITRO_HASH_ALGORITHM
ARG NITRO_PCR0
ARG NITRO_PCR1
ARG NITRO_PCR2

LABEL xyz.tempo.zone-prover.nitro.hash-algorithm="${NITRO_HASH_ALGORITHM}" \
      xyz.tempo.zone-prover.nitro.pcr0="${NITRO_PCR0}" \
      xyz.tempo.zone-prover.nitro.pcr1="${NITRO_PCR1}" \
      xyz.tempo.zone-prover.nitro.pcr2="${NITRO_PCR2}"

WORKDIR /opt/tempo-zone-prover
COPY --from=proxy-builder /build/target/release/tempo-vsock-proxy /usr/local/bin/tempo-vsock-proxy
COPY --from=prover-eif /tempo-zone-prover.eif /opt/tempo-zone-prover/tempo-zone-prover.eif
COPY --chmod=0755 zones/scripts/run-prover-host.sh /opt/tempo-zone-prover/run-prover-host.sh
RUN test -x /opt/tempo-zone-prover/run-prover-host.sh

EXPOSE 5000

USER ${PROVER_UID}:${PROVER_GID}

ENTRYPOINT ["/opt/tempo-zone-prover/run-prover-host.sh"]
