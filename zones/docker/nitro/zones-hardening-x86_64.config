# Zones' production hardening delta over the pinned AWS Nitro x86_64 config.
# The final resolved values are asserted by kernel.nix after olddefconfig.

# Several removable facilities are hidden behind EXPERT and otherwise forced to their defaults.
CONFIG_EXPERT=y

# Runtime layout randomization does not affect the reproducibility of the kernel image or PCRs.
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y

# The production enclave has no interactive kernel administration or in-place kernel replacement.
# CONFIG_DEBUG_FS is not set
# CONFIG_MAGIC_SYSRQ is not set
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set

# Remove kernel interfaces that the stateless prover does not use.
# CONFIG_IO_URING is not set
# CONFIG_BPF_SYSCALL is not set
# CONFIG_BPF_JIT is not set
# CONFIG_USERFAULTFD is not set
# CONFIG_USER_NS is not set
# CONFIG_NET_NS is not set
# CONFIG_IA32_EMULATION is not set
# CONFIG_X86_X32_ABI is not set
# CONFIG_MODIFY_LDT_SYSCALL is not set
# CONFIG_DEVMEM is not set
# CONFIG_PROC_KCORE is not set

# Low-overhead kernel memory-corruption and information-disclosure defenses.
CONFIG_HARDENED_USERCOPY=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SECURITY_DMESG_RESTRICT=y

# Fail closed on detected kernel memory corruption. AWS's baseline already builds in
# LIST_HARDENED, BUG_ON_DATA_CORRUPTION and SLAB_FREELIST_HARDENED, but without PANIC_ON_OOPS a
# detected corruption only kills the current task and the kernel keeps running. The host can
# already stop the enclave, so panicking gives an attacker no availability they lack.
CONFIG_PANIC_ON_OOPS=y

# Defenses against host-induced corruption on the vsock path with negligible runtime cost:
# per-callsite kmalloc caches hinder cross-cache heap grooming, scatterlist validation covers the
# virtio-vsock TX path, and zeroing on allocation removes uninitialized-heap information leaks.
CONFIG_RANDOM_KMALLOC_CACHES=y
CONFIG_DEBUG_SG=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
