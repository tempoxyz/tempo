FROM rust:1.96-bookworm@sha256:5e2214abe154fe26e39f64488952e5c991eeed1d6d6da7cc8381ae83927f0cfc AS chef

RUN cargo install cargo-chef@0.1.77 sccache@0.14.0 --locked

WORKDIR /app

FROM chef AS planner

COPY . .
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder

RUN apt-get update \
    && apt-get install --no-install-recommends -y \
    pkg-config \
    libssl-dev \
    build-essential \
    clang \
    libclang-dev \
    mold \
    && rm -rf /var/lib/apt/lists/*

ENV CARGO_INCREMENTAL=0 \
    RUSTC_WRAPPER=sccache \
    SCCACHE_DIR=/sccache \
    CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER=clang

ARG TARGETARCH
ARG CACHE_FAMILY=node

ARG RUST_PROFILE=profiling
ARG RUST_FEATURES="jemalloc"
ARG EXTRA_RUSTFLAGS=""
ARG RUST_BINARIES="tempo-zone tempo-zone-xtask"

COPY --from=planner /app/recipe.json recipe.json

RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked,id=zones-${TARGETARCH}-${RUST_PROFILE}-${CACHE_FAMILY}-registry \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked,id=zones-${TARGETARCH}-${RUST_PROFILE}-${CACHE_FAMILY}-git \
    --mount=type=cache,target=$SCCACHE_DIR,sharing=locked,id=zones-${TARGETARCH}-${RUST_PROFILE}-${CACHE_FAMILY}-sccache \
    set -eu; \
    for binary in $RUST_BINARIES; do \
        package="$binary"; \
        features="$RUST_FEATURES"; \
        if [ "$binary" = "tempo-zone-xtask" ]; then \
            package=tempo-xtask; \
            features=""; \
        fi; \
        RUSTFLAGS="-C link-arg=-fuse-ld=mold ${EXTRA_RUSTFLAGS}" \
        cargo chef cook --locked --profile ${RUST_PROFILE} -p "$package" --bin "$binary" \
            --features "$features" --recipe-path recipe.json; \
    done; \
    sccache --show-stats
