# CI packages the exact early-compiled binary; this Dockerfile has no Rust stage.
FROM scratch AS prover-binary
FROM scratch AS tempo-genesis
FROM debian:bookworm-slim@sha256:4724b8cc51e33e398f0e2e15e18d5ec2851ff0c2280647e1310bc1642182655d
WORKDIR /data
COPY --from=prover-binary /tempo-zone-prover-enclave /usr/local/bin/tempo-zone-prover-enclave
ARG PROVER_BINARY_SHA256
RUN echo "${PROVER_BINARY_SHA256}  /usr/local/bin/tempo-zone-prover-enclave" | sha256sum --check --strict
COPY --from=tempo-genesis / /etc/tempo/genesis/
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/tempo-zone-prover-enclave", "--tempo-genesis", "/etc/tempo/genesis"]
