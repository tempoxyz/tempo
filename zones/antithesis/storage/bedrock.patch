+string Cache::bedrock_crash (uint32_t keep_permille, uint64_t seed) {
+
+    std::unique_lock<shared_mutex> lock (lock_cache_mtx);
+
+    // One path per cached inode, in inode order: the draws are a function of
+    // the seed and the cache contents only.
+    std::map<string, string> paths;
+    for (auto const& it : this->file_inode_mapping) {
+        auto p = paths.find (it.second);
+        if (p == paths.end () || it.first < p->second)
+            paths[it.second] = it.first;
+    }
+
+    bedrock::Rng rng{seed};
+    size_t dirty_files = 0, dirty_pages = 0, kept_pages = 0, errors = 0;
+    size_t reverted_sizes = 0, truncated_bytes = 0;
+
+    for (auto const& it : paths) {
+        Item* item = _get_content_ptr (it.first);
+        if (item == nullptr)
+            continue;
+        int fd = open (it.second.c_str (), O_WRONLY);
+        if (fd < 0) {
+            errors++;
+            continue;
+        }
+        struct stat st;
+        off_t durable  = fstat (fd, &st) == 0 ? st.st_size : 0;
+        Metadata* meta = item->get_metadata ();
+        off_t size     = meta != nullptr ? meta->size : durable;
+        // The size, and blocks past the durable size, survive together
+        // (ext4 ordered mode).
+        bool keep_size = rng.chance (keep_permille);
+        size_t dirty = 0, kept = 0;
+        this->engine->persist_subset (it.first,
+                                      fd,
+                                      keep_size ? size : std::min (size, durable),
+                                      rng,
+                                      keep_permille,
+                                      &dirty,
+                                      &kept,
+                                      &errors);
+        if (size != durable) {
+            if (keep_size) {
+                if (ftruncate (fd, size) < 0)
+                    errors++;
+            } else {
+                reverted_sizes++;
+                if (size > durable)
+                    truncated_bytes += size - durable;
+            }
+        }
+        close (fd);
+        if (dirty > 0 || size != durable)
+            dirty_files++;
+        dirty_pages += dirty;
+        kept_pages += kept;
+    }
+
+    char buf[384];
+    snprintf (buf,
+              sizeof (buf),
+              "{\"dirty_files\":%zu,\"dirty_pages\":%zu,\"kept_pages\":%zu,"
+              "\"reverted_pages\":%zu,\"reverted_sizes\":%zu,\"truncated_bytes\":%zu,"
+              "\"undo_errors\":%zu}",
+              dirty_files,
+              dirty_pages,
+              kept_pages,
+              dirty_pages - kept_pages,
+              reverted_sizes,
+              truncated_bytes,
+              errors);
+    return string (buf);
+}
+
 } // namespace cache
