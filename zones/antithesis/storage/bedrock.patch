+    if (args.size () == 3 && args[0] == "crash") {
+        // Keeps a subset of the un-synced data; the caller exits right after
+        // the reply, dropping the rest with the process.
+        string stats = FSCache->bedrock_crash (std::min (std::stoul (args[1]), 1000UL),
+                                               std::stoull (args[2]));
+        return "{\"ok\":true,\"stats\":" + stats + "}";
+    } else if (args.size () == 1 && args[0] == "stats") {
+        return "{\"ok\":true}";
+    } else if (args.size () == 1 && args[0] == "checkpoint") {
+        // syncfs(2) of the mount: every file's cached data reaches the
+        // backing files, as an fsync of each would.
+        FSCache->full_checkpoint ();
+        return "{\"ok\":true}";
+    } else if (args.size () == 5 && args[0] == "torn-op") {
+        errors = add_torn_op_fault (args[1], args[2], "none", args[3], args[4]);
+    } else if (args.size () == 4 && args[0] == "torn-seq") {
+        errors = add_torn_seq_fault (args[1], "write", args[2], args[3]);
+    } else {
+        errors.push_back ("unknown command");
+    }
+    if (errors.empty ())
+        return "{\"ok\":true}";
+    string joined;
+    for (auto const& e : errors)
+        joined += (joined.empty () ? "" : "; ") + e;
+    return "{\"ok\":false,\"error\":\"" + joined + "\"}";
+}
