+void CustomCacheEngine::persist_subset (string owner,
+                                        int fd,
+                                        off_t limit,
+                                        bedrock::Rng& rng,
+                                        uint32_t keep_permille,
+                                        size_t* dirty,
+                                        size_t* kept,
+                                        size_t* errors) {
+
+    std::unique_lock<std::shared_mutex> lock (lock_cache_mtx);
+
+    auto it = this->owner_ordered_pages_mapping.find (owner);
+    if (it == this->owner_ordered_pages_mapping.end ())
+        return;
+    for (auto& blk : it->second) {
+        Page* page = std::get<1> (blk.second);
+        if (!page->is_page_dirty ())
+            continue;
+        (*dirty)++;
+        if (!rng.chance (keep_permille))
+            continue;
+        off_t off = (off_t)blk.first * this->config->IO_BLOCK_SIZE;
+        off_t len = page->allocated_block_ids.get_readable_to (blk.first) + 1;
+        if (off >= limit)
+            continue;
+        if (off + len > limit)
+            len = limit - off;
+        if (pwrite (fd, page->data + std::get<2> (blk.second).first, len, off) == len)
+            (*kept)++;
+        else
+            (*errors)++;
+    }
+}
+
 } // namespace cache::engine::backends::custom
