diff --git a/libs/libpcache/include/bedrock.hpp b/libs/libpcache/include/bedrock.hpp
new file mode 100644
index 0000000..161cdf6
--- /dev/null
+++ b/libs/libpcache/include/bedrock.hpp
@@ -0,0 +1,26 @@
+// Bedrock DST addition to LazyFS (see bedrock's nix/lazyfs.nix): a machine
+// crash that keeps a seed-chosen subset of the un-synced blocks.
+// Deterministic: the only randomness is the seed the harness passes in.
+#ifndef BEDROCK_HPP
+#define BEDROCK_HPP
+
+#include <cstdint>
+
+namespace bedrock {
+
+// SplitMix64, as tempo-dst's.
+struct Rng {
+    uint64_t s;
+    uint64_t next () {
+        s += 0x9e3779b97f4a7c15ULL;
+        uint64_t z = s;
+        z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9ULL;
+        z = (z ^ (z >> 27)) * 0x94d049bb133111ebULL;
+        return z ^ (z >> 31);
+    }
+    bool chance (uint32_t permille) { return next () % 1000 < permille; }
+};
+
+} // namespace bedrock
+
+#endif
