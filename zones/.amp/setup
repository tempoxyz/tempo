#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
source .amp/versions.env
[[ $(uname -m) == x86_64 ]] || { echo 'The pinned TIDX image requires x86_64' >&2; exit 1; }

# Docker is a system service; application containers are supervised by Amp.
if ! command -v docker >/dev/null; then
    sudo apt-get update
    sudo apt-get install -y --no-install-recommends docker.io
fi
sudo systemctl enable --now docker
sudo docker pull "$POSTGRES_IMAGE"
sudo docker pull "$CLICKHOUSE_IMAGE"
sudo docker pull "$TIDX_IMAGE"

mkdir -p .amp/deps

if [[ ! -d .amp/deps/tempo-apps/.git ]]; then
    git init .amp/deps/tempo-apps
    git -C .amp/deps/tempo-apps remote add origin https://github.com/tempoxyz/tempo-apps.git
    git -C .amp/deps/tempo-apps fetch --depth 1 origin "$EXPLORER_REV"
    git -C .amp/deps/tempo-apps checkout --detach "$EXPLORER_REV"
fi
if [[ $(git -C .amp/deps/tempo-apps rev-parse HEAD) != "$EXPLORER_REV" ]]; then
    echo 'Explorer checkout differs from .amp/versions.env; preserve local edits and update it explicitly.' >&2
    exit 1
fi
(
    cd .amp/deps/tempo-apps
    pnpm install --frozen-lockfile --filter explorer... --ignore-scripts
    pnpm --filter explorer gen:types
)
