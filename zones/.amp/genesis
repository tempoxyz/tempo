#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
# Use the same Tempo revision and Solidity runtimes as the zone binary.
manifest=$(cargo +1.96.0 metadata --locked --format-version 1 | jq -er \
    '.packages[] | select(.name == "tempo-chainspec") | .manifest_path')
temporary=$(mktemp -d)
trap 'rmdir "$temporary" 2>/dev/null || true' EXIT
target/debug/tempo-xtask install-reference-zone-factory \
    --genesis "$(dirname "$manifest")/src/genesis/dev.json" \
    --output "$temporary/genesis.json" \
    --owner 0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
mkdir -p .amp/deps
mv "$temporary/genesis.json" .amp/deps/l1-genesis.json
