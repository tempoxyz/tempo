ARG NODE_IMAGE=tempo-cluster-antithesis:latest
FROM ${NODE_IMAGE}
# Install the driver's dependencies at build time; no package resolution during simulation.
RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir antithesis==0.4.1 hegeltest==0.4.7 eth-account==0.13.7
COPY contrib/antithesis/tempo-cluster/driver/ /driver/
COPY --chmod=755 contrib/antithesis/tempo-cluster/test/ /opt/antithesis/test/
RUN mkdir -p /opt/antithesis /state && ln -s /driver /opt/antithesis/catalog
ENV PATH="/opt/venv/bin:${PATH}" PYTHONUNBUFFERED=1
ENTRYPOINT ["python3", "/driver/driver.py"]
