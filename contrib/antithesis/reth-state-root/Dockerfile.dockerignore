# Cargo resolves the entire workspace even when building one package.
# Keep local sources and member manifests, but no unrelated repository content.
**
!Cargo.toml
!Cargo.lock
!LICENSE-APACHE
!LICENSE-MIT
!README.md
!mainnet-network-identity.json
!testnet-network-identity.json
!bin/**
!crates/**
!xtask/**
!contrib/antithesis/reth-state-root/Cargo.toml
!contrib/antithesis/reth-state-root/src/**
!contrib/antithesis/reth-state-root/generate_sparse_buckets.py
!contrib/antithesis/reth-state-root/verify_sparse_symbols.py
!contrib/antithesis/reth-state-root/patch-sparse-trie.py
!contrib/antithesis/reth-state-root/sparse-branch.patch
!contrib/antithesis/reth-state-root/test/**
!contrib/antithesis/trie-shapes/Cargo.toml
!contrib/antithesis/trie-shapes/src/**

# Apply these exclusions after the source allowlist, including nested copies.
**/target/
**/.git
**/.env
**/.env.*
**/*.pem
**/*.key
**/.aws/
**/.ssh/
**/.cargo/credentials
**/.cargo/credentials.toml
