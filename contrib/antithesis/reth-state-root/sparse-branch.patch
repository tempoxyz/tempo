+// Docker-only exploration hook; normal Reth builds do not contain this macro.
+macro_rules! sometimes_each {
+    ($branch_path_len:expr, $is_root:expr, $state_mask:expr, $revealed_mask:expr, $leaf_mask:expr) => {{
+        unsafe extern "C" {
+            fn antithesis_sparse_branch_shape(
+                branch_path_len: usize,
+                is_root: bool,
+                state_mask: u16,
+                revealed_mask: u16,
+                leaf_mask: u16,
+            );
+        }
+        // SAFETY: the workload exports this exact primitive-only C ABI signature.
+        unsafe {
+            antithesis_sparse_branch_shape(
+                $branch_path_len,
+                $is_root,
+                $state_mask,
+                $revealed_mask,
+                $leaf_mask,
+            );
+        }
+    }};
+}
